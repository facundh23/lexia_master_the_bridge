# === Database ===
DATABASE_URL=postgresql://lexia:lexia_dev_password@localhost:5432/lexia
POSTGRES_USER=lexia
POSTGRES_PASSWORD=lexia_dev_password
POSTGRES_DB=lexia

# === Chroma ===
CHROMA_URL=http://localhost:8000

# === MinIO ===
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=lexia_dev_access
MINIO_SECRET_KEY=lexia_dev_secret_change_me
MINIO_BUCKET=lexia-uploads

# === SMTP (mailhog dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@lexia.local

# === API ===
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# === Better Auth ===
BETTER_AUTH_SECRET=replace_me_with_64_random_chars_in_real_envs_only
BETTER_AUTH_URL=http://localhost:4000

# === Field-level encryption ===
# Generar PII_ENCRYPTION_KEY con: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace_me_with_pgcrypto_compatible_key
# Generar FIELD_ENCRYPTION_SALT con: openssl rand -hex 32
FIELD_ENCRYPTION_SALT=replace_me_with_random_hex_64chars

# === LLM providers (Fase 2+) ===
ANTHROPIC_API_KEY=
# Model with extended thinking support for eligibility agent (falls back to ANTHROPIC_MODEL)
ANTHROPIC_THINKING_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
# Cohere Rerank v3.5 — optional, falls back to vector distance order if absent
COHERE_API_KEY=

# === Langfuse (observabilidad — Fase 3+) ===
# Self-hosted: levantar con docker-compose up langfuse
# Cloud: https://cloud.langfuse.com → crear proyecto → copiar keys
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=dev_pk_lexia_replace_in_prod
LANGFUSE_SECRET_KEY=dev_sk_lexia_replace_in_prod
LANGFUSE_BASEURL=http://localhost:3001

# === Triage model (Fase 3+) ===
TRIAGE_MODEL=claude-haiku-4-5-20251001

# Security — Canary Tokens & Guardrail Models
LEXIA_CANARY_TOKEN=LEXIA_CANARY_ALPHA_7291
GUARDRAIL_MODEL=claude-haiku-4-5-20251001
VALIDATOR_MODEL=claude-haiku-4-5-20251001

# Admin access — comma-separated list of admin email addresses
ADMIN_EMAILS=


# === Embeddings ===
# Proveedor de embeddings para el RAG: "local" (Transformers.js, gratis, offline) u "openai"
EMBEDDING_PROVIDER=local
# local  -> modelo de HuggingFace (Xenova/*), 384 dim, multilingüe
# openai -> text-embedding-3-small, 1536 dim (requiere OPENAI_API_KEY con crédito)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
