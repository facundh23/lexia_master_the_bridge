{
  "name": "lexia",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "detector": "tsx scripts/detector-worker.ts",
    "eval": "tsx scripts/eval-runner.ts",
    "eval:smoke": "tsx scripts/eval-runner.ts --smoke",
    "eval:persist": "tsx scripts/eval-runner.ts --persist",
    "red-team": "tsx scripts/red-team.ts",
    "ab-safety": "tsx scripts/ab-safety.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "langsmith@<0.6.0": ">=0.6.0",
      "esbuild@<=0.24.2": ">=0.25.0",
      "fast-xml-parser@<5.7.0": ">=5.7.0",
      "tinypool@<2.1.2": "^2.1.2",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.2",
      "ip-address@<10.3.1": "^10.3.1",
      "postcss@<8.5.18": "^8.5.18",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=5.0.0 <5.0.11": "^5.0.11",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "browserslist@<4.28.7": "^4.28.7",
      "source-map-js@<1.2.2": "^1.2.2",
      "vite@<6.4.4": "^6.4.4",
      "sharp@<0.35.5": "^0.35.5",
      "adm-zip@<0.6.1": "^0.6.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-qr28-fpjm-wq7f"
      ]
    }
  }
}
